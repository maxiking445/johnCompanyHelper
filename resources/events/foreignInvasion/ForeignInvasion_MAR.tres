script = ExtResource("1_73j00")
eventName = "Foreign Invasion"
eventLocation = 5
ruleText = "Roll the storm die and resolve an Invasion Crisis and/or Attack against theCompany in each region linked to a storm (Bombay for West Indian, Madras forSouth Indian, and Bengal for East Indian). If all storms are rolled, resolve thisevent once in each. If no storms are rolled, resolve this event in the region onthe top card of the draw stack instead. "
