eventName = "Crisis"
eventLocation = 4
ruleText = "Like Peace, the location of the Crisis is determined by the placement ofthe Elephant piece, not by the top tile of the draw stack. The Elephant'stail (where it is walking.from) indicates the attacker. The Elephant's head(where it is walking to) indicates the defender. After resolving a Crisis,perform the Elephant's March."
